{
  "name": "@atcharajs/native",
  "version": "0.1.2",
  "description": "Native Node.js bindings for Atchara",
  "type": "commonjs",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "binaryName": "atchara",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "scripts": {
    "clean": "rm -rf *.node index.js index.d.ts profile && cargo clean",
    "build": "napi build --platform --release --strip",
    "build:debug": "napi build --platform",
    "build:profile": "napi build --platform --release",
    "prepublishOnly": "napi prepublish -t npm",
    "artifacts": "napi artifacts",
    "test": "cargo test --lib",
    "lint": "cargo clippy",
    "typecheck": "cargo check"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.5.1",
    "vitest": "^4.0.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jankdc/atchara.git",
    "directory": "packages/native"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
